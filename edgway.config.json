    "@edgway/plugin-cors",
    "@edgway/plugin-http-log",
    "@edgway/plugin-ip-restriction",
    "@edgway/plugin-jwt",
    "@edgway/plugin-key-auth",
    "@edgway/plugin-openid-connect",
    "@edgway/plugin-proxy-cache",
    "@edgway/plugin-rate-limiting",
