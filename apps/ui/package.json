{
  "name": "@edgway/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Edgway's admin UI: React, ra-core and shadcn-admin-kit over @edgway/sdk, served by the admin Worker under /ui/",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -w exec tsx tools/licenses/notices.ts ui apps/ui/public/licenses.txt && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test:e2e": "vite build && playwright test",
    "screens": "vite build && E2E_SCREENS=1 playwright test screens.spec.ts"
  },
  "dependencies": {
    "@edgway/adapters-cf": "workspace:*",
    "@edgway/constants": "workspace:*",
    "@edgway/errors": "workspace:*",
    "@edgway/i18n": "workspace:*",
    "@edgway/sdk": "workspace:*",
    "@edgway/tokens": "workspace:*",
    "@edgway/ui-kit": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@peculiar/x509": "2.1.0",
    "@rjsf/core": "^6.11.0",
    "@rjsf/shadcn": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.49.0",
    "monaco-editor": "0.57.0",
    "ra-core": "^5.15.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^12.1.3",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "reflect-metadata": "0.2.2",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "jose": "^6.2.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "4.124.0"
  }
}
