{
  "name": "@edgway/portal",
  "version": "0.0.0",
  "private": true,
  "description": "Edgway's developer portal: Zudoku with self-serve API keys, served by the edgway-portal Worker",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "zudoku dev",
    "build": "pnpm -w exec tsx tools/licenses/notices.ts portal apps/portal/public/licenses.txt && ZUDOKU_DISABLE_UPDATE_CHECK=1 ZUDOKU_DO_NOT_TRACK=1 zudoku build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@edgway/adapters-cf": "workspace:*",
    "@edgway/admin-core": "workspace:*",
    "@edgway/constants": "workspace:*",
    "@edgway/errors": "workspace:*",
    "@edgway/i18n": "workspace:*",
    "@edgway/telemetry": "workspace:*",
    "@edgway/tokens": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "openid-client": "6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "recharts": "^3.10.1",
    "zudoku": "0.88.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "miniflare": "5.20260815.0-alpha",
    "oauth2-mock-server": "^9.2.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
