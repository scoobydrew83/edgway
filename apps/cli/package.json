{
  "name": "edgway",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobydrew83/edgway.git",
    "directory": "apps/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "The Edgway CLI: set up, deploy, import decK files, review and publish gateway changes",
  "type": "module",
  "bin": {
    "edgway": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "node scripts/build.mjs && vitest run",
    "prepack": "pnpm run build && node ../../tools/release/prepack.mjs",
    "postpack": "node ../../tools/release/postpack.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@clack/prompts": "^1.8.1",
    "c12": "^3.3.4",
    "citty": "0.2.2",
    "diff": "^9.0.0",
    "knitwork": "^1.3.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "wrangler": "^4.124.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@edgway/admin-core": "workspace:*",
    "@edgway/constants": "workspace:*",
    "@edgway/core": "workspace:*",
    "@edgway/errors": "workspace:*",
    "@edgway/i18n": "workspace:*",
    "@edgway/kong-compat": "workspace:*",
    "@edgway/plugin-sdk": "workspace:*",
    "@edgway/schema": "workspace:*",
    "@edgway/sdk": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
