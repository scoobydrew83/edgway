    "@edgway/tokens": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diacritic": "0.0.2",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.49.0",
    "next-themes": "0.4.6",
    "query-string": "^9.5.1",
    "react-dropzone": "^20.1.2",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.65.0",
