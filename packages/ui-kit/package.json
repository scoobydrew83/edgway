  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "ra-core": "^5.15.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "ra-core": "^5.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4"
