{
  "name": "@edgway/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobydrew83/edgway.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Edgway phase runner (Kong phases, priorities and scopes on Hono middleware) and adapter interfaces",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE",
    "third-party"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build && node ../../tools/release/prepack.mjs",
    "postpack": "node ../../tools/release/postpack.mjs"
  },
  "dependencies": {
    "@edgway/constants": "workspace:*",
    "@edgway/errors": "workspace:*",
    "cockatiel": "^4.0.0",
    "hono-rate-limiter": "0.5.4"
  },
  "devDependencies": {
    "@edgway/schema": "workspace:*",
    "hono": "^4.13.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "hono": "^4.12.34"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
