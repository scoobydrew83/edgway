{
  "name": "@edgway/constants",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobydrew83/edgway.git",
    "directory": "packages/constants"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Edgway shared constants: header names, KV key formats, limits and defaults",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build && node ../../tools/release/prepack.mjs",
    "postpack": "node ../../tools/release/postpack.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
