{
  "name": "@edgway/schema",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobydrew83/edgway.git",
    "directory": "packages/schema"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Edgway entity and plugin schemas, generated from Kong's published JSON Schemas (zod)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./deck": "./src/generated/deck.ts"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE",
    "third-party"
  ],
  "scripts": {
    "codegen": "tsx scripts/codegen-plugins.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build && node ../../tools/release/prepack.mjs",
    "postpack": "node ../../tools/release/postpack.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "uuidv7": "^1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.20.4",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./deck": {
        "types": "./dist/generated/deck.d.ts",
        "import": "./dist/generated/deck.js",
        "default": "./dist/generated/deck.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
