{
  "name": "@edgway/plugin-sdk",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobydrew83/edgway.git",
    "directory": "packages/plugin-sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Define Edgway plugins: Kong names, priorities and schemas; phase handlers that are plain Hono middleware",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./registry": "./src/registry.ts"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build && node ../../tools/release/prepack.mjs",
    "postpack": "node ../../tools/release/postpack.mjs"
  },
  "dependencies": {
    "@edgway/constants": "workspace:*",
    "@edgway/core": "workspace:*",
    "@edgway/errors": "workspace:*",
    "@edgway/i18n": "workspace:*",
    "c12": "^3.3.4",
    "knitwork": "^1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@edgway/schema": "workspace:*",
    "@types/node": "^22.20.4",
    "hono": "^4.13.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "hono": "^4.12.34"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js",
        "default": "./dist/testing.js"
      },
      "./registry": {
        "types": "./dist/registry.d.ts",
        "import": "./dist/registry.js",
        "default": "./dist/registry.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
